<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="AFFILIATE_FEATURE_REFERRAL_CAPTURE" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_COMMISSION_CREATION" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_COMMISSION_RELEASE" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_CONFIRMED_REFUNDS" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_WALLET_WITHDRAWALS" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_ADMINISTRATION" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_CLICK_TRACKING" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_ANALYTICS" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_MEDIA_LIBRARY" value="false" force="true"/>
        <env name="AFFILIATE_FEATURE_EMPLOYEE_ENROLLMENT" value="false" force="true"/>
        <env name="AFFILIATE_EMPLOYEE_ROLES" value="Admin,SystemAdmin,BranchAdmin,Teacher,blog" force="true"/>
        <env name="AFFILIATE_EMPLOYEE_ENROLLMENT_ATTEMPTS_PER_MINUTE" value="6" force="true"/>
        <env name="AFFILIATE_DEFAULT_LOCALE" value="th" force="true"/>
        <env name="AFFILIATE_VISITOR_HASH_KEY" value="test-only-affiliate-visitor-key-32-chars" force="true"/>
        <env name="AFFILIATE_ALLOWED_DESTINATION_HOSTS" value="localhost" force="true"/>
        <env name="AFFILIATE_MAINTENANCE_MODE" value="false" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="CREDIT_NOTE_FEATURE_ENABLED" value="false" force="true"/>
        <env name="CREDIT_NOTE_FINANCIAL_ACTIONS_ENABLED" value="false" force="true"/>
        <env name="CREDIT_NOTE_ISSUER_LEGAL_NAME" value="Demo Credit Note Issuer" force="true"/>
        <env name="CREDIT_NOTE_ISSUER_LEGAL_ADDRESS" value="Demo Test Address" force="true"/>
        <env name="CREDIT_NOTE_ISSUER_TAX_ID" value="0105561171606" force="true"/>
        <env name="CREDIT_NOTE_ISSUER_BRANCH_TYPE" value="head_office" force="true"/>
        <env name="CREDIT_NOTE_ISSUER_BRANCH_CODE" value="00000" force="true"/>
    </php>
</phpunit>
